# --- server ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/herguide
CLIENT_URL=http://localhost:5173

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Used from Phase 6 onward
AI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5

# Optional: used only by `npm run seed` to create the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- client (client/.env) ---
# VITE_API_URL=https://your-api.example.com   # leave unset in dev (Vite proxies /api)
# VITE_CONTACT_EMAIL=
